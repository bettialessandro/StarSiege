@page "/"
@using StarSiege.Game
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Star Siege</PageTitle>

<div class="stage">
    <div class="screen">
        <canvas @ref="_canvas"></canvas>

        @if (_engine.State == GameState.Title)
        {
            <div class="overlay">
                <h1 class="logo">STAR<br />SIEGE</h1>
                <p class="subtitle">Difendi la Terra dall'assedio!</p>
                <table class="legend">
                    <tr><td><span class="dot ufo"></span></td><td>= ? MISTERO</td></tr>
                    <tr><td><span class="dot a"></span></td><td>= 30 PUNTI</td></tr>
                    <tr><td><span class="dot b"></span></td><td>= 20 PUNTI</td></tr>
                    <tr><td><span class="dot c"></span></td><td>= 10 PUNTI</td></tr>
                </table>
                <button class="btn" @onclick="StartGame">GIOCA</button>
                <p class="help">← → / A D muovi &nbsp;·&nbsp; SPAZIO spara &nbsp;·&nbsp; M audio &nbsp;·&nbsp; INVIO start</p>
            </div>
        }
        else if (_engine.State == GameState.GameOver)
        {
            <div class="overlay">
                <h1 class="gameover">GAME OVER</h1>
                <p class="final">PUNTEGGIO: @_engine.Score</p>
                @if (_newRecord)
                {
                    <p class="record blink">NUOVO RECORD!</p>
                }
                <button class="btn" @onclick="StartGame">RIGIOCA</button>
            </div>
        }
        else if (_engine.State == GameState.LevelClear)
        {
            <div class="overlay transparent">
                <h2 class="blink">LIVELLO @_engine.Level COMPLETATO</h2>
            </div>
        }
    </div>

    <div class="touch" @ref="_touch">
        <button data-touch="left" aria-label="Sinistra">◀</button>
        <button data-touch="fire" class="fire" aria-label="Fuoco">●</button>
        <button data-touch="right" aria-label="Destra">▶</button>
    </div>

    <footer>Made with Blazor WebAssembly · .NET @Environment.Version.Major</footer>
</div>

@code {
    readonly GameEngine _engine = new();
    ElementReference _canvas, _touch;
    IJSObjectReference? _module;
    DotNetObjectReference<Home>? _self;
    bool _newRecord;
    int _hiAtStart;

    protected override void OnInitialized()
    {
        _engine.StateChanged += OnEngineStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/game.js");
        _engine.HiScore = await _module.InvokeAsync<int>("loadHiScore");
        _self = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("start", _canvas, _self, _touch);
        if (Nav.Uri.Contains("autostart")) StartGame(); // es. /?autostart per partire subito
    }

    [JSInvokable]
    public float[] Tick(float dt, int keys) => _engine.Tick(dt, keys);

    [JSInvokable]
    public void OnEnter()
    {
        if (_engine.State is GameState.Title or GameState.GameOver) StartGame();
    }

    void StartGame()
    {
        _hiAtStart = _engine.HiScore;
        _newRecord = false;
        _engine.NewGame();
    }

    void OnEngineStateChanged()
    {
        if (_engine.State == GameState.GameOver)
        {
            _newRecord = _engine.Score > _hiAtStart;
            if (_newRecord) _ = _module?.InvokeVoidAsync("saveHiScore", _engine.HiScore).AsTask();
        }
        _ = InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        _engine.StateChanged -= OnEngineStateChanged;
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("stop"); await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
        _self?.Dispose();
    }
}
